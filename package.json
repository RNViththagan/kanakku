{
  "name": "kanakku",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && pnpm -r --if-present run check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "pnpm --filter @kanakku/web build",
    "start": "pnpm build && node packages/server/bin/kanakku.mjs start",
    "dev": "node scripts/dev.mjs",
    "prepare": "simple-git-hooks",
    "cli:install": "node scripts/install-cli.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/check-private.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
